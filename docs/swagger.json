{
  "openapi": "3.0.0",
  "info": {
    "title": "Backend",
    "version": "1.0.0",
    "description": "Authentication API documentation for the Fullstack Project"
  },
  "servers": [
    {
      "url": "http://localhost:4002/api/auth",
      "description": "Development Server (Auth Routes)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Authentication and authorization endpoints"
    }
  ],
  "paths": {
    "/register": {
      "post": {
        "summary": "Register a new user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "dateOfBirth": { "type": "string", "example": "1990-01-01" },
                  "gender": { "type": "string", "example": "Male" },
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "number": { "type": "string", "example": "1234567890" },
                  "password": { "type": "string", "minLength": 8, "example": "secret123" }
                },
                "required": ["firstName", "lastName", "dateOfBirth", "gender", "email", "number", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" },
          "400": { "description": "Bad Request (missing fields, invalid password, or invalid date format)" },
          "409": { "description": "Email is already registered" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "password": { "type": "string", "example": "secret123" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful. Returns user data and JWT access token." },
          "400": { "description": "Email and password are required" },
          "401": { "description": "Invalid email or password" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "summary": "Request a password reset OTP",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "john@example.com" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "If an account with this email exists, a password reset link has been sent." },
          "400": { "description": "Email is required" },
          "500": { "description": "Unable to process password reset or send email" }
        }
      }
    },
    "/verify-otp": {
      "post": {
        "summary": "Verify the 6-digit OTP sent to the user's email",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "otp": { "type": "string", "example": "123456" }
                },
                "required": ["email", "otp"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP verified successfully" },
          "400": { "description": "Invalid or expired OTP" },
          "500": { "description": "Unable to verify OTP" }
        }
      }
    },
    "/reset-password": {
      "post": {
        "summary": "Update the password (after OTP verification)",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "john@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "newpassword123" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password updated successfully" },
          "400": { "description": "User not found or missing fields" },
          "500": { "description": "Unable to reset password" }
        }
      }
    }
  }
}

